instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   https://pdm.fming.dev/latest/usage/project/#working-with-version-control
.pdm.toml
.pdm-python
.pdm-build/

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# Local test video assets (large, product-specific)
/videos/

# Large parity baselines generated by scripts/test_transformers_compat_parity.py;
# captured on the patched transformers==4.53.2 env, multi-GB, not checked in.
tests/fixtures/

# Annotated debug videos from examples/dewu_video_switch/replay_debug.py (regenerable)
debug_*.mp4
# Batch validation outputs (annotated videos + terminal logs; large, regenerable)
debug_runs/
# Local test scene videos (large; web/videos symlinks point at these)
white_shoe_*.mp4
# Editor caches / local IDE config
.vscode/
# Local dewu demo scene videos (large, product-specific)
dewu-*.mp4

# ---- Media assets: images & videos ----
# No image/video binaries are checked into this repo; keep them all out of git
# (product clips, camera frames, annotated debug dumps like dewu_blue_*/*.jpg, etc.).
# Commit vector/source art (*.svg) normally — it is intentionally excluded below.
# Images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.tif
*.tiff
*.ico
*.heic
# Videos
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.flv
*.wmv

# ---- Local dewu detector debug output (regenerable) ----
# JSONL snapshot logs written by examples/dewu_video_switch/app.py (default) and
# replay_debug.py, plus the blue-detection frame-dump directories. Per-run, litter
# the repo root; never commit them.
dewu_debug_*.jsonl
dewu_blue_*/
dewu_*_debug/
